# ── Postgres (pgvector) ─────────────────────────────
POSTGRES_USER=setu_user
POSTGRES_PASSWORD=setu_password
POSTGRES_DB=setu_db

# ── MongoDB (raw docs / clause trees / LLM logs) ────
MONGO_USER=setu_user
MONGO_PASSWORD=setu_password
MONGO_DB=setu_files

# ── Auth ────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me
JWT_EXPIRATION=7d
# Seed 1 sebi_admin + 3 intermediaries on first boot (empty users table). Set false to skip.
SEED_ON_BOOT=true

# ── AI service / LLM (OpenAI-compatible, pluggable) ─
AI_SERVICE_KEY=dev-ai-key
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_LARGE=gpt-4o
LLM_MODEL_SMALL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
